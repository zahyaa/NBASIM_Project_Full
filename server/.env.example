MONGODB_URI=mongodb://localhost:27017/nbasim
JWT_SECRET=change_this_to_a_random_secret
BALLDONTLIE_API_KEY=your_api_key_here

# --- Production hardening ---
# Comma-separated list of allowed browser origins. REQUIRED in production.
# Example: CORS_ORIGIN=https://nbasim.gg,https://www.nbasim.gg
CORS_ORIGIN=

# --- Stripe (primary card processor) ---
# Server uses the secret key to create PaymentIntents and process refunds.
# The publishable key is sent to the browser via /api/payments/catalog so
# Stripe.js / Elements can tokenize the card client-side.
# Use sk_test_* / pk_test_* for sandbox, sk_live_* / pk_live_* for production.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- PayPal ---
# Live: https://api-m.paypal.com   Sandbox: https://api-m.sandbox.paypal.com
# When PAYPAL_API_BASE is unset the server picks live in production and
# sandbox otherwise. Switch the credentials below to live values for launch.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_BASE=
