# Production env for the Node API on Ubuntu. Install at /srv/nbasim/nbasim.env
# with mode 0600, owned by the `nbasim` system user (see nbasim-api.service).
# Do NOT commit a populated copy of this file.

NODE_ENV=production
PORT=5001

# Strong random string (>=32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=

# MongoDB Atlas connection string (or local mongodb://127.0.0.1:27017/nbasim)
MONGODB_URI=

# Comma-separated allow-list. MUST include the Netlify-served frontend origin.
CORS_ORIGIN=https://bballsim.app,https://www.bballsim.app

# Optional: external NBA stats API key
BALLDONTLIE_API_KEY=

# Stripe (live)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (live). PAYPAL_API_BASE auto-flips to api-m.paypal.com when NODE_ENV=production.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_BASE=https://api-m.paypal.com
